{
  "name": "worklabs-registry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:worklabs": "node scripts/sync-worklabs.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:registry": "vite",
    "build:registry": "tsc -b && vite build",
    "build:demos": "npm --prefix \"React Components/playground\" run build",
    "bundle:demos": "node scripts/bundle-demos.mjs",
    "build": "npm run sync:worklabs && npm run build:demos && npm run build:registry && npm run bundle:demos",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "lenis": "^1.3.26",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
